  const rc = _txt(_qbRescan['消息数']).trim();
  const nc = Number(rc);
  if (rc && Number.isFinite(nc)) return _msgCount <= nc + 1;
  const rf = _txt(_qbRescan['楼层']).trim();
  const nf = Number(rf);
