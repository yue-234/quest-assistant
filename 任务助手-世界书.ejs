  const _metaBit = _metaParts.join('，');
_%>
<% if (it.accepted && !_qbTouchBoard) { _%>
    - [<%- it.id %>｜<%- it.category %>｜<%- it.rank %>级｜已接取:<%- it.formalTaskName %><% if (it.advanceReason) { %>｜待演进:<%- it.advanceReason %><% } %>]<% if (it.category !== '支线任务' && it.summary) { %> 摘要：<%- it.summary %><% } %><% if (it.category !== '支线任务' && it.truth) { %>｜幕后真相：<%- it.truth %><% } %><% if (it.rewardItems.length) { %>｜预期收益：<%- it.rewardItems.map((r) => `[${r.slot}${r.claimed ? '✓' : '□'}]${r.text}`).join('、') %>｜打勾Patch：<%- _claimPatchHint(it) %><% } %><% if (_removePatchHint(it)) { %>｜结案移出：<%- _removePatchHint(it) %><% } %>
