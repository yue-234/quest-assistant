    - [<%- it.id %>｜<%- it.category %>｜<%- it.rank %>级｜<%- it.way %><% if (it.accepted) { %>｜已接取:<%- it.formalTaskName %><% } else if (it.intent) { %>｜★已锁定<% } %><% if (it.advanceReason) { %>｜待演进:<%- it.advanceReason %><% } %>] <%- it.title %><% if (_metaBit) { %>（<%- _metaBit %>）<% } %><% if (!it.accepted && it.progress) { %>｜进展：<%- it.progress %><% } %><% if ((_showDetail || (it.accepted && it.category !== '支线任务')) && it.summary) { %>｜摘要：<%- it.summary %><% } %><% if ((_showDetail || it.accepted) && it.truth) { %>｜幕后真相：<%- it.truth %><% } %><% if (!it.accepted && it.guide) { %>｜引导：<%- it.guide %><% } %><% if ((it.intent || it.accepted) && it.rewardItems.length) { %>｜预期收益：<%- it.rewardItems.map((r) => `[${r.slot}${r.claimed ? '✓' : '□'}]${r.text}`).join('、') %>｜打勾Patch：<%- _claimPatchHint(it) %><% } else if (_showDetail && it.rewards.length) { %>｜预期收益：<%- it.rewards.join('、') %><% } %><% if (it.accepted && _removePatchHint(it)) { %>｜结案移出：<%- _removePatchHint(it) %><% } %>
<% } _%>
<% }) _%>
<% } _%>
